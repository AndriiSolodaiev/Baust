
extends ../layout/main
block variable
  -
    var title_page = 'single-glamping'
    var id_page = 'id-page-single-glamping'
    var class_page = 'class-page-single-glamping'
    var headerCustomClass = 'type1' 
    var breadcrumbsSubitem = [
      {
        label: 'About',
        link: pagesLink[0].about
      }
    ]
  
block meta
  title= title_page
  meta(name='description', content='')
block head
    link(rel='stylesheet', href="./assets/styles/main.min.css")
block scripts
  script(defer src='./assets/scripts/vendors.bundle.js')
  script(defer src='./assets/scripts/header.bundle.js')
  script(defer src='./assets/scripts/footer.bundle.js')
  script(defer src='./assets/scripts/singleGlamping.bundle.js')
block content
  section.filler.sg
    .video-frame 
      img(src="./assets/images/glampings.jpg ", alt="")
    .container
      h1.section-title Glamping

        br
        span #22.01
      
      p.section-descr.mobile-mode Modular glamping unit, ready for any climate, priced at 
        span.accent-color €70,000.
    .hero-bottom-block 
      p.section-descr.tablet-mode Modular glamping unit, ready for any climate, priced at 
        span.accent-color €70,000.
      a(href="#calculator").general-btn
        .hover-wrap
          .svg-wrap 
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M7.22703 6.77297H16.773V16.3189M16.1101 7.43588L6.43153 17.1144" stroke="#E0F09D" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          span Get ROI Calculator
  section.details.container 
    .details-container
      .planning-explication-block
        .planning-img-wrap
          img(src="./assets/images/glamping-plan.png", alt="glamping plan")
        .explication-wrap   
          .explication-title Layout & Dimensions:
          .card__descr-wrap 
            .card__descr-item 
              h4.card__descr-item__title Main room:
              .card__descr-item__blank 
              p.card__descr-item__value 19.15 m²
            .card__descr-item 
              h4.card__descr-item__title Bathroom:
              .card__descr-item__blank 
              p.card__descr-item__value 4.67 m²
            .card__descr-item 
              h4.card__descr-item__title Terrace:
              .card__descr-item__blank 
              p.card__descr-item__value 10.28 m²
            .card__descr-item 
              h4.card__descr-item__title Total area:
              .card__descr-item__blank 
              p.card__descr-item__value 23.8 m²
            .card__descr-item 
              h4.card__descr-item__title Structure:
              .card__descr-item__blank 
              p.card__descr-item__value Two modules
            .card__descr-item 
              h4.card__descr-item__title Construction:
              .card__descr-item__blank 
              p.card__descr-item__value Solid timber frame
            .card__descr-item 
              h4.card__descr-item__title Weight
              .card__descr-item__blank 
              p.card__descr-item__value ~7.5 tons
          button.general-btn(data-call-us-btn)
            .hover-wrap
              .svg-wrap 
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M7.22703 6.77297H16.773V16.3189M16.1101 7.43588L6.43153 17.1144" stroke="#E0F09D" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              span Book a call
      .room-tour-wrap(data-iframe-open data-iframe-src="https://apartment-tours.smartorange.com.ua/mulberry/?scene=0") 
        img(src="./assets/images/image.jpg", alt="iframe")
        .room-tour-overlay 
          .top-text-wrap 
            p Room tour
            <svg xmlns="http://www.w3.org/2000/svg" width="331" height="42" viewBox="0 0 331 42" fill="none">
              <path d="M38.0251 1L46 7.2549C18.1062 10.8386 1 15.6763 1 20.9997C1 32.0456 74.6492 41 165.5 41C256.351 41 330 32.0456 330 20.9997C330 15.6129 312.484 10.7236 284 7.12754L291.812 1" stroke="#F2EFE9" stroke-width="2"/>
            </svg>
          button(data-popup-tour-btn).project-card__bottom 
            p View interior 360°
            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
              <path d="M8.22703 8.77297H17.773V18.3189M17.1101 9.43588L7.43153 19.1144" stroke="#F2EFE9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
  section.features.container
    .big-b b
    .decor-svg 
      <svg xmlns="http://www.w3.org/2000/svg" width="768" height="871" viewBox="0 0 768 871" fill="none">
      <g filter="url(#filter0_f_919_7155)">
      <path d="M807 693H-38V663.568L807 8V693Z" fill="url(#paint0_linear_919_7155)"/>
      </g>
      <defs>
      <filter id="filter0_f_919_7155" x="-215.6" y="-169.6" width="1200.2" height="1040.2" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feFlood flood-opacity="0" result="BackgroundImageFix"/>
      <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
      <feGaussianBlur stdDeviation="88.8" result="effect1_foregroundBlur_919_7155"/>
      </filter>
      <linearGradient id="paint0_linear_919_7155" x1="-48.3973" y1="710.605" x2="883.19" y2="229.066" gradientUnits="userSpaceOnUse">
      <stop stop-color="#E0F09D"/>
      <stop offset="1" stop-color="#E0F09D" stop-opacity="0"/>
      </linearGradient>
      </defs>
      </svg>
    h2.features-title Features
      span Key
    .swiper-process 
      .swiper-wrapper 
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/feature1.jpg", alt="process step 1")
          .process__text-wrap
            h3.process__item-title Sleeps 2
            p.process__item-descr A thoughtfully designed and cozy retreat, offering all the essentials for a peaceful and comfortable stay for two guests.
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/feature2.jpg", alt="process step 2")
          .process__text-wrap
            h3.process__item-title 24 m² interior
            p.process__item-descr Smart use of 24 m² provides a spacious feel with modern design, combining style, function, and comfort in every corner.
        .swiper-slide.empty
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/feature3.jpg", alt="process step 3")
          .process__text-wrap
            h3.process__item-title ‑35 °C → +40 °C certified
            p.process__item-descr Built to perform in any climate — from freezing winters to scorching summers — ensuring year-round comfort and protection.
        .swiper-slide.empty
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/feature4.jpg", alt="process step 4")
          .process__text-wrap
            h3.process__item-title Plug‑&‑Play utilities
            p.process__item-descr No hassle setup — all utilities are pre-installed and ready to use, so you can settle in and start living right away.
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/feature5.jpg", alt="process step 4")
          .process__text-wrap
            h3.process__item-title Full bath & kitchen
            p.process__item-descr Enjoy home-like convenience with a full bathroom and kitchen, giving you complete independence during your stay.
  section.room-tour 
    iframe( src="https://apartment-tours.smartorange.com.ua/mulberry/?scene=0" loading="lazy")
    .room-tour-block 
    .top-text-wrap 
      p Room tour
      <svg xmlns="http://www.w3.org/2000/svg" width="331" height="42" viewBox="0 0 331 42" fill="none">
        <path d="M38.0251 1L46 7.2549C18.1062 10.8386 1 15.6763 1 20.9997C1 32.0456 74.6492 41 165.5 41C256.351 41 330 32.0456 330 20.9997C330 15.6129 312.484 10.7236 284 7.12754L291.812 1" stroke="#F2EFE9" stroke-width="2"/>
      </svg>  
    .room-tour-btns-wrap
      button.header-btn(data-mobile-explore) 
        .hover-wrap
          span Explore tour
      button.header-btn(data-mobile-pause) 
        .hover-wrap
          span Pause
  section.calculator.container(id="calculator")
    h2.section-title ROI
      span Calculator
    .calculator__inner
      .calculator__controls-wrap
        h3.calculator__title Evaluate the effectiveness of your investments
        .calculator__info-wrap 
          button.info-btn
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M9.09658 6.42198L6.80658 6.70898L6.72458 7.08898L7.17458 7.17198C7.46858 7.24198 7.52658 7.34798 7.46258 7.64098L6.72458 11.109C6.53058 12.006 6.82958 12.428 7.53258 12.428C8.07758 12.428 8.71058 12.176 8.99758 11.83L9.08558 11.414C8.88558 11.59 8.59358 11.66 8.39958 11.66C8.12458 11.66 8.02458 11.467 8.09558 11.127L9.09658 6.42198ZM9.16658 4.33398C9.16658 4.5992 9.06122 4.85355 8.87368 5.04109C8.68615 5.22863 8.43179 5.33398 8.16658 5.33398C7.90136 5.33398 7.64701 5.22863 7.45947 5.04109C7.27194 4.85355 7.16658 4.5992 7.16658 4.33398C7.16658 4.06877 7.27194 3.81441 7.45947 3.62688C7.64701 3.43934 7.90136 3.33398 8.16658 3.33398C8.43179 3.33398 8.68615 3.43934 8.87368 3.62688C9.06122 3.81441 9.16658 4.06877 9.16658 4.33398Z" fill="#E0F09D"/>
            </svg>
          .calculator__info-popup 
            p Nightly rate — average price per night per unit. The price range is based on the lowest and highest competitor prices.
            p Occupancy rate — average percentage of nights sold in a year (out of 365). Calculated using the average values of European competitors.
            p Number of units — total number of units in the portfolio. The more units, the lower the costs per unit and the higher the profit.
            p Operating costs — share of expenses as a % of revenue (cleaning, laundry, management/OTA fees, energy, minor repairs, insurance, marketing, land rent, etc.). Calculated using the average values of glamping sites in Europe.
        .calculator__controls
          .calculator__control
            label(for="nightly-rate") Nightly rate:
              span.range-min €150 - 
              span.range-max &nbsp€1200
            input#nightly-rate(type="text" name="nightly-rate" data-range="nightly-rate")

          .calculator__control
            label(for="occupancy-rate") Occupancy rate:
              span.range-min 40% - 
              span.range-max &nbsp95%
            input#occupancy-rate(type="text" name="occupancy-rate" data-range="occupancy-rate")

          .calculator__control
            label(for="units") Number of units:
              span.range-min 1 - 
              span.range-max &nbsp50
            input#units(type="text" name="units" data-range="units")

          .calculator__control
            label(for="operating-costs") Operating costs:
              span.range-min 30% - 
              span.range-max &nbsp70%
            input#operating-costs(type="text" name="operating-costs" data-range="operating-costs")
      .calculator__results-wrap
        .calculator__results
          .calculator__result(data-result="total-income")
            span.title Total annual income:
            span.value-wrap
              span.currency €&nbsp
              span.value(data-value="total-income") 426 540
              span.unit &nbsp/year

          .calculator__result(data-result="net-income")
            span.title Net annual income:
            strong.value-wrap
              span.currency €&nbsp
              span.value(data-value="net-income") 36 540
              span.unit &nbsp/year

          .calculator__result(data-result="roi")
            span.title Estimated ROI:
            span.value-wrap
              span.value(data-value="roi") 45
              span.big-unit &nbsp%

          .calculator__result(data-result="payback")
            span.title Payback period:
            span.value-wrap
              span.value(data-value="payback") 2–4
              span.big-unit &nbspyears
        p.calculator__disclaimer *The calculations are indicative and do not constitute financial advice.
  section.gallery 
    .swiper-gallery 
      .swiper-btn-wrap.container 
        .swiper-button-prev(data-gallery-prev-btn)
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M11.8353 18.8047L5.08525 12.0547L11.8353 5.30469M6.02275 12.0547L19.7103 12.0547" stroke="#333333" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        .swiper-button-next(data-gallery-next-btn)
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M12.1648 5.19531L18.9148 11.9453L12.1648 18.6953M17.9773 11.9453L4.28979 11.9453" stroke="#333333" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
      .slider-numbers
        span.current-slides-number 01
        span /
        span.total-slides-number 02
      .swiper-wrapper 
        .swiper-slide 
          img(src="./assets/images/glampings.jpg", alt="glamping")
        .swiper-slide 
          img(src="./assets/images/glampings.jpg", alt="glamping")
        .swiper-slide 
          img(src="./assets/images/glampings.jpg", alt="glamping")
  section.section.operating.process.container
    .title-wrap
      h2.section-title Use
        br
        | Cases
      p.section-descr Our modular units serve a variety of needs — from hospitality to business. Whether it’s a cozy retreat, a workspace, or a mobile sales point, they offer flexibility, quick setup, and modern comfort.
    .swiper-cases 
      .swiper-wrapper 
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/cases1.jpg", alt="process step 1")
          .process__text-wrap
            h3.process__item-title Hotel rooms
            p.process__item-descr Stylish, self-contained spaces ideal for both short getaways and extended stays. Easy to install and operate in remote or urban areas.
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/cases2.jpg", alt="process step 2")
          .process__text-wrap
            h3.process__item-title Guest house
            p.process__item-descr A private, fully equipped unit that adds comfort and flexibility to your property — perfect for hosting friends, family, or even renters.
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/cases3.jpg", alt="process step 3")
          .process__text-wrap
            h3.process__item-title Office
            p.process__item-descr A quiet, dedicated space for focus, productivity, and comfort — perfect for remote work, creative tasks, or meetings.
        .swiper-slide 
          .process__img-wrap 
            img(src="./assets/images/cases4.jpg", alt="process step 4")
          .process__text-wrap
            h3.process__item-title Sales office
            p.process__item-descr A mobile, branded space you can deploy quickly at any location — ideal for real estate viewings, pop-up events, or client meetings.      
   
block footer
  include ../includes/footer.pug

block header
  include ../includes/header.pug
